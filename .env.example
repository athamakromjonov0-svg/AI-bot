# ========================================================
# Telegram Bot & Userbot Configuration
# ========================================================

# Application Environment (development, production)
NODE_ENV=development
PORT=3000

# 1. Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Owner Security
# Your personal Telegram numeric ID (e.g. from @userinfobot)
# Only this Telegram user will have access to manage the bot and agent
OWNER_TELEGRAM_ID=123456789

# 3. Telegram Userbot (from https://my.telegram.org)
# Get from "API development tools"
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here

# Userbot String Session (Generated automatically via `npm run login`)
TELEGRAM_SESSION=

# Secret key used for AES-256 encryption of userbot sessions & sensitive tokens
SESSION_ENCRYPTION_KEY=super_secret_encryption_key_change_me_32chars

# 4. Database (MongoDB)
# Local or MongoDB Atlas (e.g. mongodb+srv://user:pass@cluster.mongodb.net/agentbot)
MONGODB_URI=mongodb://localhost:27017/telegram_ai_bot

# 5. Redis (BullMQ Queues)
# If left empty or Redis is offline, the system will automatically fall back to an in-memory queue
REDIS_URL=redis://localhost:6379

# 6. AI LLM Provider (OpenAI SDK compatible: OpenRouter, OpenAI, Groq, Ollama, DeepSeek)
# Examples:
# OpenRouter: BASE_URL=https://openrouter.ai/api/v1, MODEL=openai/gpt-4o-mini or anthropic/claude-3.5-haiku
# OpenAI:     BASE_URL=https://api.openai.com/v1, MODEL=gpt-4o-mini
# Groq:       BASE_URL=https://api.groq.com/openai/v1, MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_MAX_STEPS=10

# 7. Agent Behavior & Safety
# Default mode for automated responses: 'draft' (requires owner approval) or 'auto' (direct sending)
DEFAULT_AUTO_REPLY_MODE=draft

# Max messages to retrieve when reading history per query
MAX_HISTORY_LIMIT=50

# Telegram FloodWait maximum seconds to wait automatically
MAX_FLOOD_WAIT_SECONDS=60
